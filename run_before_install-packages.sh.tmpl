#!/bin/bash
set -euo pipefail

# --- Package list ---
packages=(zsh kitty neovim starship ttf-jetbrains-mono-nerd git curl zip unzip)
missing_packages=()

# --- Arch/Manjaro ---
if [ -f /etc/arch-release ]; then
    echo "Verificando pacotes do sistema..."

    for pkg in "${packages[@]}"; do
        if ! pacman -Qi "$pkg" &> /dev/null; then
            missing_packages+=("$pkg")
        fi
    done

    if [ ${#missing_packages[@]} -gt 0 ]; then
        echo "Instalando pacotes ausentes: ${missing_packages[*]}"
        sudo pacman -S --needed --noconfirm "${missing_packages[@]}"
    else
        echo "Todos os pacotes já estão instalados. Pulando etapa."
    fi
fi
